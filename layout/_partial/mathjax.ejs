<% if (theme.mathjax){ %>
<%# MathJax 3 is vendored under js/mathjax/ and only loaded by js/math.js when the article contains TeX %>
<style>mjx-container[display="true"]{overflow-x:auto;overflow-y:hidden;max-width:100%}</style>
<script id="mathjax-config" type="text/plain" data-src="<%- url_for('js/mathjax/tex-chtml.js') %>"></script>
<%- js('js/math.js') %>
<% } %>
