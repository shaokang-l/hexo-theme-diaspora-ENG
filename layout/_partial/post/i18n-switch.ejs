<%# language switch on a translated post (sibs = i18n_siblings(page)); in the AJAX preview diaspora.js swaps the translation in place %>
<nav class="i18n-switch" aria-label="Languages · 语言"><% sibs.forEach(function (s, i) { %><% if (i) { %><span class="i18n-sep" aria-hidden="true">|</span><% } %><% if (s.current) { %><a class="i18n-link is-current" href="<%- url_for(s.path) %>" hreflang="<%= s.lang %>" lang="<%= s.lang %>" title="<%= s.title || 'Untitled' %>" aria-current="page"><%= s.label %></a><% } else { %><a class="i18n-link" href="<%- url_for(s.path) %>" hreflang="<%= s.lang %>" lang="<%= s.lang %>" title="<%= s.title || 'Untitled' %>" rel="alternate"><%= s.label %></a><% } %><% }) %></nav>
