<% var first=page.posts.sort("date", "desc" ).eq(0); %>
<% var heroSibs = first && typeof i18n_siblings == 'function' ? i18n_siblings(first) : []; %>
<% var nprHero=theme.npr && theme.npr.enable && theme.npr.hero; %>
    <div id="screen">
        <div id="mark">
            <div class="layer" data-depth="0.4">
                <%- image_tag(theme.welcome_cover || first.cover || "/img/welcome-cover.jpg" , {id: "cover" ,
                    crossorigin: "anonymous" , width: 1920, height: 1080}) %>
            </div>
            <% if (nprHero) { %>
                <div id="npr-hero" aria-hidden="true"></div>
                <% } %>
        </div>
        <div id="vibrant" <% if (nprHero) { %>data-npr-overlay="<%= theme.npr.overlay_color || '#102a33' %>"
            data-npr-accent="<%= theme.npr.accent_color || '#f5c46a' %>" <% } %>>
            <svg viewbox="0 0 2880 1620" height="100%" preserveaspectratio="xMaxYMax slice">
                <polygon opacity="0.7" points="2000,1620 0,1620 0,0 600,0 " />
            </svg>
            <div></div>
        </div>
        <div id="header">
            <div>
                <a class="image-logo" href="/"></a>
                <% if (theme.local_search.enable){ %>
                    <div class="iconfont icon-search switchsearch" href="/search/" title="搜索"></div>
                    <%}%>
                        <div class="iconfont icon-menu switchmenu"></div>
            </div>
        </div>
        <% if ( first ) { %>
            <div id="post0"<% if (heroSibs.length && is_home()) { %> data-i18n="<%= i18n_cards(heroSibs, {length: 60, locale: 'en-us', untitled: config.title}) %>"<% } %>>
                <p data-i18n-field="date">
                    <%- first.date.locale("en-us").format("MMMM DD, YYYY") %>
                </p>
                <h2>
                    <%- link_to(first.path, first.title || config.title, {class: "posttitle" }) %>
                </h2>
                <p class="summary" data-i18n-field="summary">
                    <%- truncate(strip_html(first.content), {length: 60, omission: '...' }) %>
                </p>
                <% if (heroSibs.length) { %><%- partial('_partial/post/i18n-chips', {sibs: heroSibs}) %><% } %>
            </div>
            <% } %>
    </div>